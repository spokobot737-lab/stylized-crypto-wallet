{
  "name": "stylized-crypto-wallet",
  "version": "0.3.0",
  "private": true,
  "description": "FRAME Wallet \u2022 a personal multi-chain desktop wallet",
  "author": "spokobot737-lab",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env WALLET_DEV=1 electron .\"",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "preview": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "bip32": "^5.0.0",
    "bip39": "^3.1.0",
    "bitcoinjs-lib": "^7.0.5",
    "bs58": "^6.0.0",
    "ed25519-hd-key": "^1.3.0",
    "ethers": "^6.15.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tiny-secp256k1": "^2.2.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "45.2.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.4.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "app.frame.wallet",
    "productName": "FRAME Wallet",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/tiny-secp256k1/lib/secp256k1.wasm"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "FRAME-Wallet-${version}-Setup-${arch}.${ext}",
      "icon": "build/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icons/icon.ico",
      "uninstallerIcon": "build/icons/icon.ico",
      "installerHeaderIcon": "build/icons/icon.ico"
    },
    "publish": null,
    "mac": {
      "icon": "build/icons/icon.icns",
      "category": "public.app-category.finance"
    },
    "linux": {
      "icon": "build/icons/icon.png",
      "category": "Finance"
    }
  },
  "overrides": {
    "jayson": "^5.0.0"
  }
}
